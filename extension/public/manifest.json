{
  "manifest_version": 3,
  "name": "Pipeline",
  "version": "0.5.0",
  "description": "Save, monitor and archive research material into your team's shared Google Sheet. Canary inboxes stay in this browser.",
  "icons": { "128": "canary.png" },
  "action": { "default_title": "Open Pipeline", "default_icon": "canary.png" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "permissions": ["alarms", "offscreen", "unlimitedStorage", "downloads", "downloads.open", "pageCapture", "scripting", "storage", "contextMenus", "activeTab", "debugger", "tabs"],
  "host_permissions": [
    "https://data.gdeltproject.org/*",
    "https://news.google.com/*",
    "https://search.mediacloud.org/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "optional_host_permissions": ["<all_urls>", "https://*/*", "http://*/*", "https://huggingface.co/*", "https://*.hf.co/*"],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*", "https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/watch*", "https://www.facebook.com/*"],
      "js": ["capture/page-text.js", "capture/content.js"],
      "css": ["capture/content.css"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["capture/context-tracker.js"]
    }
  ]
}
